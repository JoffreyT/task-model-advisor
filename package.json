{
  "name": "task-model-advisor",
  "displayName": "Task Model Advisor",
  "description": "Recommend the best available LLM (model, context, thinking) for a task using live benchmarks.",
  "version": "0.1.0",
  "publisher": "jft63",
  "repository": {
    "type": "git",
    "url": "https://github.com/JoffreyT/task-model-advisor.git"
  },
  "engines": {
    "vscode": "^1.128.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "taskModelAdvisor.recommend",
        "title": "Task Model Advisor: Recommend a model for this task"
      }
    ],
    "keybindings": [
      {
        "command": "taskModelAdvisor.recommend",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      }
    ],
    "configuration": {
      "title": "Task Model Advisor",
      "properties": {
        "taskModelAdvisor.artificialAnalysis.apiKey": {
          "type": "string",
          "default": "",
          "description": "Artificial Analysis Data API key"
        },
        "taskModelAdvisor.cursor.apiKey": {
          "type": "string",
          "default": "",
          "description": "Cursor API key (Dashboard → API Keys). Used to list account models via `agent --list-models` / GET https://api.cursor.com/v1/models when vscode.lm is empty."
        },
        "taskModelAdvisor.language": {
          "type": "string",
          "enum": [
            "en",
            "fr"
          ],
          "default": "en",
          "description": "Language for Task Model Advisor prompts, recommendations, and notifications."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval:ranking": "vitest run ranking-eval --reporter=verbose",
    "package": "vsce package --skip-license",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --max-warnings 0",
      "prettier --check"
    ],
    "*.{md,json,mjs,yml,yaml}": [
      "prettier --check"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/vscode": "1.125.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.0": true,
    "fsevents@2.3.3": true
  }
}
